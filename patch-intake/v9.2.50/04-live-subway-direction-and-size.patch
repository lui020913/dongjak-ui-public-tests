diff --git a/app/tests/live-transit-lanes.test.mjs b/app/tests/live-transit-lanes.test.mjs
new file mode 100644
--- /dev/null
+++ b/app/tests/live-transit-lanes.test.mjs
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {TRAIN_ICON_SIZE_STOPS,TRAIN_LANE_GAP,trainLaneOffset,trainLaneOffsetExpression,providerRailDirection,resolveRailDirection,railDirectionLabel} from '../src/features/liveTransit/train-lanes.js';
+const rad=Math.PI/180;
+// MapLibre icon-offset is rotated in local sprite coordinates.
+function screenOffset(line,angle,facing){
+  const rotation=(angle-(facing==='left'?180:0))*rad;
+  const y=trainLaneOffset(line,facing,true);
+  return [-Math.sin(rotation)*y,Math.cos(rotation)*y];
+}
+test('icon growth is about 22% at all original zoom stops',()=>{
+  const old=[.66,.74,.84,1.13,1.42];
+  assert.deepEqual(TRAIN_ICON_SIZE_STOPS.filter((_,i)=>i%2===0),[11,12.5,13.2,15.5,18]);
+  TRAIN_ICON_SIZE_STOPS.filter((_,i)=>i%2===1).forEach((size,i)=>assert(size/old[i]>=1.20&&size/old[i]<=1.24));
+});
+test('opposing trains remain on correct sides through arbitrary screen rotations and sprite mirroring',()=>{
+  for(const angle of [0,32,90,120,179,225,270,340])for(const facing of ['left','right']){
+    const travel=[Math.cos(angle*rad),Math.sin(angle*rad)];
+    for(const line of ['1호선','2호선','4호선','7호선','9호선','신림선']){
+      const [x,y]=screenOffset(line,angle,facing);
+      const cross=travel[0]*y-travel[1]*x;
+      const expected=(line==='1호선'?-1:1)*TRAIN_LANE_GAP;
+      assert(Math.abs(cross-expected)<1e-8);
+      const [rx,ry]=screenOffset(line,angle+180,facing);
+      assert(Math.abs(rx+x)<1e-8&&Math.abs(ry+y)<1e-8);
+    }
+  }
+});
+test('unknown heading, unrecognized line and unavailable data are not assigned an invented lane',()=>{
+  assert.equal(trainLaneOffset('1호선','right',false),0);
+  assert.equal(trainLaneOffset('7호선',null,true),0);
+  assert.equal(trainLaneOffset('unknown','right',true),0);
+  assert.deepEqual(trainLaneOffsetExpression().at(-1),['literal',[0,0]]);
+});
+test('official direction codes and Korean labels are supported',()=>{
+  for(const value of [0,'0','상행','내선','내선순환'])assert.equal(providerRailDirection(value),'up');
+  for(const value of [1,'1','하행','외선','외선순환'])assert.equal(providerRailDirection(value),'down');
+  assert.equal(providerRailDirection(''),null);
+  assert.equal(railDirectionLabel('1호선','up'),'상행');
+  assert.equal(railDirectionLabel('9호선','down'),'하행');
+  assert.equal(railDirectionLabel('2호선','up'),'내선순환');
+  assert.equal(railDirectionLabel('2호선','down'),'외선순환');
+});
+test('loop direction takes precedence; linear routes retain destination correction',()=>{
+  assert.equal(resolveRailDirection('2호선','0',2,0,null),'up');
+  assert.equal(resolveRailDirection('2호선','1',0,2,null),'down');
+  assert.equal(resolveRailDirection('2호선','',0,2,null),null);
+  assert.equal(resolveRailDirection('9호선','0',2,0,null),'down');
+  assert.equal(resolveRailDirection('7호선','',-1,-1,'up'),'up');
+});
diff --git a/app/tests/live-transit-lanes-integration.test.mjs b/app/tests/live-transit-lanes-integration.test.mjs
new file mode 100644
--- /dev/null
+++ b/app/tests/live-transit-lanes-integration.test.mjs
@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {buildDongjakMetroLines} from '../src/features/liveTransit/integrate.js';
+import {metroToFeatures} from '../src/features/liveTransit/normalize.js';
+import {trainFacing,trainRotation} from '../src/features/liveTransit/index.js';
+import {trainLaneOffset} from '../src/features/liveTransit/train-lanes.js';
+const now=Date.parse('2026-11-20T14:00:00Z');
+const row=(over={})=>({id:'test',line:'2호선',trainNo:'123',station:'신림',status:'2',observedAt:new Date(now-30000).toISOString(),...over});
+test('2호선 inner next stop is 신대방, outer is 봉천',()=>{
+  const lines=buildDongjakMetroLines();
+  const [inner]=metroToFeatures([row({direction:'0',destination:'봉천'})],lines,now);
+  const [outer]=metroToFeatures([row({direction:'1',destination:'신대방'})],lines,now);
+  assert.equal(inner.properties.nextStation,'신대방');
+  assert.equal(outer.properties.nextStation,'봉천');
+  assert.equal(inner.properties.travelDirection,'up');assert.equal(outer.properties.travelDirection,'down');
+  assert(inner.properties.headingKnown&&outer.properties.headingKnown);
+  const [unknown]=metroToFeatures([row({direction:'',destination:'봉천'})],lines,now);
+  assert.equal(unknown.properties.headingKnown,false);
+});
+test('opposite train directions have distinct lanes without changing geometry',()=>{
+  for(const line of ['1호선','7호선']){
+    const a=[126.94,37.5],b=[126.95,37.5];
+    const cfg={[line]:{stations:[{name:'A',lngLat:a},{name:'B',lngLat:b}],geometry:{coordinates:[a,b]},segmentTimeSeconds:60}};
+    const [up,down]=metroToFeatures([row({line,station:'A',direction:'0',id:'up'}),row({line,station:'B',direction:'1',id:'down'})],cfg,now);
+    assert(Math.abs(up.geometry.coordinates[0]-down.geometry.coordinates[0])<1e-8);
+    assert.equal(up.geometry.coordinates[1],down.geometry.coordinates[1]);
+    for(const f of [up,down])assert.equal(trainRotation({},f.properties,trainFacing({},f.properties)),0);
+    const u=trainLaneOffset(line,trainFacing({},up.properties),up.properties.headingKnown);
+    const d=trainLaneOffset(line,trainFacing({},down.properties),down.properties.headingKnown);
+    assert.equal(u,line==='1호선'?-8:8);assert.equal(d,-u);
+  }
+});
